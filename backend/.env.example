# Application
APP_NAME=FinPilot AI
APP_ENV=development
SECRET_KEY=change-this-to-a-64-char-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Database
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot_secret@localhost:5432/finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_secret
POSTGRES_DB=finpilot

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379/0
REDIS_PASSWORD=redis_secret

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# AI
GOOGLE_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=models/embedding-001
GEMINI_MODEL=gemini-1.5-pro

# Celery
CELERY_BROKER_URL=redis://:redis_secret@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@localhost:6379/2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
